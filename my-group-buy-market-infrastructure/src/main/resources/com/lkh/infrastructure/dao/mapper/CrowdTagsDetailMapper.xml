<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lkh.infrastructure.dao.CrowdTagsDetailMapper">

    <resultMap id="BaseResultMap" type="com.lkh.infrastructure.dao.po.CrowdTagsDetail">
            <id property="id" column="id" />
            <result property="tagId" column="tag_id" />
            <result property="userId" column="user_id" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,tag_id,user_id,create_time,update_time
    </sql>
    <insert id="saveCrowdTagsDetailMapper">
        insert into crowd_tags_detail (tag_id,user_id,create_time,update_time)
        values (#{tagId},#{userId},#{createTime},#{updateTime})
    </insert>
    <select id="queryTagUsersByTagId" resultMap="BaseResultMap">
        select * from crowd_tags_detail
        where tag_id = #{tagId}
    </select>
    <select id="queryTagIdByUserId" resultType="java.lang.String">
        select tag_id from crowd_tags_detail
        where user_id = #{userId}
    </select>
    <select id="queryUserIdByTagId" resultType="java.lang.String">
        select user_id from crowd_tags_detail
        where tag_id = #{tagId}
    </select>
</mapper>
