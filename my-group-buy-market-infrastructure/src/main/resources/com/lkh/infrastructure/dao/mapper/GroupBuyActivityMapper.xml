<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lkh.infrastructure.dao.GroupBuyActivityMapper">

    <resultMap id="BaseResultMap" type="com.lkh.infrastructure.dao.po.GroupBuyActivity">
            <id property="id" column="id" />
            <result property="activityId" column="activity_id" />
            <result property="activityName" column="activity_name" />
            <result property="discountId" column="discount_id" />
            <result property="groupType" column="group_type" />
            <result property="takeLimitCount" column="take_limit_count" />
            <result property="target" column="target" />
            <result property="validTime" column="valid_time" />
            <result property="status" column="status" />
            <result property="startTime" column="start_time" />
            <result property="endTime" column="end_time" />
            <result property="tagId" column="tag_id" />
            <result property="tagScope" column="tag_scope" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,activity_id,activity_name,
        discount_id,group_type,take_limit_count,target,valid_time,
        status,start_time,end_time,tag_id,tag_scope,
        create_time,update_time
    </sql>
    <select id="queryGroupBuyActivityList" resultMap="BaseResultMap">
    select * from group_buy_activity

    </select>
 <!--   <select id="queryDiscountList" resultMap="BaseResultMap">
        select * from group_buy_activity
        where goods_id = #{goodsId} and source = #{source} and channel = #{channel}
    </select>-->
    <select id="queryActivityById" resultMap="BaseResultMap">
        select * from group_buy_activity
        where activity_id = #{activityId}
    </select>

</mapper>
