    <select id="countAllTeamNumber" resultType="java.lang.Integer">
        select count(*)
        from group_buy_order
        where source = #{source} and channel = #{channel} and activity_id = #{activityId} and status in (1,0)
    </select>
    <select id="countAllCompleteTeamNumber" resultType="java.lang.Integer">
        select count(*)
        from group_buy_order
        where source = #{source} and channel = #{channel} and activity_id = #{activityId}
          and status in (0,1)
    </select>
    <select id="queryListWithLimit" resultMap="BaseResultMap">
        select gbo.* from group_buy_order gbo
        where
        gbo.source = #{req.source} and gbo.channel = #{req.channel}
        and gbo.activity_id = #{req.activityId} and gbo.status = 0
        and gbo.valid_end_time &gt; now()
        and gbo.lock_count &lt; gbo.target_count
        and exists (
            select 1
            from group_buy_order_list gbol
            where gbol.team_id = gbo.team_id
              and gbol.goods_id = #{goodsId}
              and gbol.source = #{req.source}
              and gbol.channel = #{req.channel}
        )
        <if test="req.teamId != null and req.teamId != ''">
            and gbo.team_id != #{req.teamId}
        </if>
        limit #{count}
    </select>
