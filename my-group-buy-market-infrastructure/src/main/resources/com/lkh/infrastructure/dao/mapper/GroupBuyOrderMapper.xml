<mapper namespace="com.lkh.infrastructure.dao.GroupBuyOrderMapper">

    <resultMap id="BaseResultMap" type="com.lkh.infrastructure.dao.po.GroupBuyOrder">
            <id property="id" column="id" />
            <result property="teamId" column="team_id" />
            <result property="activityId" column="activity_id" />
            <result property="source" column="source" />
            <result property="channel" column="channel" />
            <result property="originalPrice" column="original_price" />
            <result property="deductionPrice" column="deduction_price" />
            <result property="payPrice" column="pay_price" />
            <result property="targetCount" column="target_count" />
            <result property="completeCount" column="complete_count" />
            <result property="lockCount" column="lock_count" />
            <result property="status" column="status" />
            <result property="validStartTime" column="valid_start_time"/>
            <result property="validEndTime" column="valid_end_time"/>
            <result property="notifyUrl" column="notify_url"/>
            <result property="notifyType" column="notify_type"/>
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,team_id,activity_id,source,channel,original_price,
        deduction_price,pay_price,target_count,complete_count,lock_count,
        status,valid_start_time,valid_end_time,notify_url,notify_type,create_time,update_time
    </sql>
    <insert id="insert">
        insert into group_buy_order (team_id,activity_id,source,channel,original_price,
                                     deduction_price,pay_price,target_count,complete_count,lock_count,
                                     status,valid_start_time,valid_end_time,notify_url,notify_type,create_time,update_time)
        values (
                #{teamId},#{activityId},#{source},#{channel},#{originalPrice},
               #{deductionPrice},#{payPrice},#{targetCount},#{completeCount},#{lockCount},
                #{status},#{validStartTime},#{validEndTime},#{notifyUrl},#{notifyType},#{createTime},#{updateTime}
               )
    </insert>
    <update id="incyOneCount">
        update group_buy_order set lock_count = lock_count + 1
        where team_id = #{teamId} and lock_count &lt; target_count
    </update>
    <update id="setSuccessGroupBuyOrderStatus">
        update group_buy_order set status = #{status}
        where team_id = #{teamId}
    </update>
    <update id="incyCompleteCount">
        update group_buy_order set complete_count = complete_count + 1
        where team_id = #{teamId}
    </update>
    <update id="setSuccessIfCompleteTarget">
        update group_buy_order set status = #{status}
        where team_id = #{teamId} and target_count = complete_count
    </update>
    <select id="query" resultMap="BaseResultMap">
        select id, team_id, activity_id, source, channel, original_price,
               deduction_price, pay_price, target_count, complete_count,
               lock_count, status,valid_start_time,valid_end_time,notify_url,notify_type, create_time, update_time
        from group_buy_order
        <where>
            <if test="@com.lkh.infrastructure.utils.MyBatisParamUtil@isNotEmpty(id)">
                and id = #{id}
            </if>

            <if test="@com.lkh.infrastructure.utils.MyBatisParamUtil@isNotEmpty(teamId)">
