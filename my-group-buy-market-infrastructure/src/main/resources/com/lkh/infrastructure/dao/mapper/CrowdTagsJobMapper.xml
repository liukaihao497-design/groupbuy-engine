<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lkh.infrastructure.dao.CrowdTagsJobMapper">

    <resultMap id="BaseResultMap" type="com.lkh.infrastructure.dao.po.CrowdTagsJob">
            <id property="id" column="id" />
            <result property="tagId" column="tag_id" />
            <result property="batchId" column="batch_id" />
            <result property="tagType" column="tag_type" />
            <result property="tagRule" column="tag_rule" />
            <result property="statStartTime" column="stat_start_time" />
            <result property="statEndTime" column="stat_end_time" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,tag_id,batch_id,tag_type,tag_rule,stat_start_time,
        stat_end_time,status,create_time,update_time
    </sql>
    <select id="queryCrowdTagsJob" resultMap="BaseResultMap">
        select * from crowd_tags_job
        where tag_id = #{tagId} and batch_id = #{batchId}
    </select>
</mapper>
